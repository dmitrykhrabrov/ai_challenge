DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# none|low|high|max — дефолт челленджа low (у DeepSeek без параметра ≈ high)
DEEPSEEK_REASONING_EFFORT=low
HOST=127.0.0.1
PORT=8000

# --- День 5: OpenRouter (сравнение моделей) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Опционально: подпись для рейтинга OpenRouter
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=ai-challenge-day5


# Локальный прокси (Clash/V2Ray). Нужен, если система гонит HTTPS через MITM.
HTTPS_PROXY=http://127.0.0.1:10809
# false — как http.proxyStrictSSL=false в VS Code (только для локальной учёбы).
SSL_VERIFY=false
# Альтернатива безопаснее: экспорт CA из Clash и путь сюда, SSL_VERIFY=true.
# SSL_CA_BUNDLE=C:\path\to\clash-ca.crt
