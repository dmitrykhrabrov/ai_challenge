DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# none|low|high|max — дефолт челленджа low (у DeepSeek без параметра ≈ high)
DEEPSEEK_REASONING_EFFORT=low
HOST=127.0.0.1
PORT=8000

# --- День 5: OpenRouter (сравнение моделей) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Опционально: подпись для рейтинга OpenRouter
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=ai-challenge-day5

# --- День 6: Agent limits (код, не prompt) ---
AGENT_MAX_ITERATIONS=8
AGENT_MAX_SAME_TOOL_CALLS=2

# --- День 7: session JSONL ---
AGENT_SESSION_DIR=data/sessions
AGENT_SESSION_ID=default

# День 9 — контекст: full | summary_simple | summary_facts
AGENT_CONTEXT_MODE=full
AGENT_KEEP_LAST=6
AGENT_SUMMARIZE_EVERY=10

# Оценка ₽ в UI (off-peak USD за 1M; peak в коде ×2)
# https://api-docs.deepseek.com/quick_start/pricing/
DEEPSEEK_PRICE_FLASH_INPUT_HIT_1M=0.003
DEEPSEEK_PRICE_FLASH_INPUT_MISS_1M=0.15
DEEPSEEK_PRICE_FLASH_OUTPUT_1M=0.60
USD_RUB_RATE=95

# Яндекс.Почта (IMAP) — пароль приложения, не основной пароль
YANDEX_MAIL_USER=you@yandex.ru
YANDEX_MAIL_APP_PASSWORD=
YANDEX_IMAP_HOST=imap.yandex.com

# Яндекс.Календарь (CalDAV). Можно те же user/password приложения.
YANDEX_CALDAV_USER=
YANDEX_CALDAV_APP_PASSWORD=
YANDEX_CALDAV_URL=https://caldav.yandex.ru
# Путь календаря, например /calendars/you@yandex.ru/events-xxxx/
YANDEX_CALENDAR_PATH=

# Битрикс24 входящий вебхук (без завершающего /method)
# https://example.bitrix24.ru/rest/1/xxxxxxxx
BITRIX24_WEBHOOK_URL=

# Локальный прокси (Clash/V2Ray). Нужен, если система гонит HTTPS через MITM.
HTTPS_PROXY=http://127.0.0.1:10809
# false — как http.proxyStrictSSL=false в VS Code (только для локальной учёбы).
SSL_VERIFY=false
# Альтернатива безопаснее: экспорт CA из Clash и путь сюда, SSL_VERIFY=true.
# SSL_CA_BUNDLE=C:\path\to\clash-ca.crt
